{"info":{"description":"小米摄像头 fnOS 插件 API。给第三方客户端（Mac App / Home Assistant / 脚本）接入用。","title":"MiCam API","version":"0.11.0"},"openapi":"3.0.3","paths":{"/accounts":{"get":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"小米账号列表（不含凭据）"}},"summary":"账号列表","tags":["账号"]}},"/accounts/backups":{"get":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"备份列表"}},"summary":"凭据备份文件列表","tags":["账号"]}},"/accounts/export":{"get":{"description":"含 passToken，敏感。用于重装后恢复，无需重新扫码。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"JSON 文件"}},"summary":"导出账号凭据","tags":["账号"]}},"/accounts/import":{"post":{"description":"导入前自动把现有文件备份成 accounts.json.bak。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"ok + count"}},"summary":"导入账号凭据","tags":["账号"]}},"/accounts/qr":{"post":{"description":"返回二维码图片 URL 与登录 URL。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"二维码信息"}},"summary":"发起扫码登录","tags":["账号"]}},"/accounts/qr/status":{"get":{"description":"状态：waiting / scanned / confirmed / expired","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"扫码状态"}},"summary":"轮询扫码状态","tags":["账号"]}},"/accounts/status":{"get":{"description":"三层凭据说明 + 每个账号的会话状态。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"账号状态 + explain"}},"summary":"账号凭据状态","tags":["账号"]}},"/dev/capabilities":{"get":{"description":"客户端据此决定用 HLS 还是 MJPEG、支持哪些功能。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"能力清单"}},"summary":"能力探测","tags":["开发者"]}},"/dev/config":{"post":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"已保存"}},"summary":"修改开放模式开关","tags":["开发者"]}},"/dev/docs":{"get":{"responses":{"200":{"description":"Markdown 文本"}},"summary":"Markdown 文档","tags":["开发者"]}},"/dev/openapi":{"get":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"OpenAPI JSON"}},"summary":"本规格文档（OpenAPI 3.0）","tags":["开发者"]}},"/dev/status":{"get":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"解锁状态与开关"}},"summary":"开发者模式状态","tags":["开发者"]}},"/dev/tap":{"post":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"解锁进度"}},"summary":"点击计数（7 次解锁）","tags":["开发者"]}},"/devices":{"get":{"description":"只返回摄像头（含共享家庭的）。字段：did/name/model/isOnline/localip/shared/shareFlag","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"摄像头列表"}},"summary":"摄像头列表","tags":["设备"]}},"/devices/all":{"get":{"description":"包含非摄像头设备。字段含 type/isCamera。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"全部设备"}},"summary":"全部设备列表","tags":["设备"]}},"/diag/bundle":{"get":{"responses":{"200":{"description":"tar.gz 文件"}},"summary":"诊断包（tar.gz）","tags":["诊断"]}},"/diag/report":{"get":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"诊断 JSON"}},"summary":"诊断报告（已脱敏）","tags":["诊断"]}},"/health":{"get":{"description":"返回应用名、状态与版本号。客户端启动时先调这个。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"{\"app\":\"micam\",\"ok\":true,\"version\":\"x.y.z\"}"}},"summary":"健康检查","tags":["系统"]}},"/homes":{"get":{"description":"含共享家庭（shared=true）。共享设备必须用该家庭的 ownerId 查询。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"家庭列表"}},"summary":"家庭列表","tags":["设备"]}},"/live/cred-status":{"get":{"description":"每台摄像头的 P2P 凭据年龄、估算剩余有效期、刷新冷却时间。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"凭据状态列表"}},"summary":"设备凭据状态","tags":["播放"]}},"/live/hls":{"get":{"description":"返回 m3u8 播放列表。分片通过同一路径 + seg 参数获取。注意：m3u8 里的分片行是相对路径（hls?did=X\u0026seg=seg0.ts），播放器按相对路径解析即可，不要手工拼接。","parameters":[{"description":"设备 DID","in":"query","name":"did","required":true,"schema":{"type":"string"}},{"description":"帧率，默认 15，上限 15","in":"query","name":"fps","required":false,"schema":{"type":"string"}},{"description":"宽度，0=原画（2K 2560），可选 1280/640","in":"query","name":"w","required":false,"schema":{"type":"string"}},{"description":"分片文件名（如 seg0.ts），留空返回播放列表","in":"query","name":"seg","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"m3u8 播放列表 或 video/mp2t 分片"}},"summary":"HLS 播放（推荐）","tags":["播放"]}},"/live/hls/info":{"get":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"硬件能力与编码器"}},"summary":"HLS 能力信息","tags":["播放"]}},"/live/mjpeg":{"get":{"description":"multipart/x-mixed-replace，boundary=mjpegframe。每帧带准确 Content-Length。注意：CFNetwork 读不了这个类型，iOS/macOS 需用裸 socket 读取。","parameters":[{"description":"设备 DID","in":"query","name":"did","required":true,"schema":{"type":"string"}},{"description":"帧率，默认 12","in":"query","name":"fps","required":false,"schema":{"type":"string"}},{"description":"宽度，0=原画","in":"query","name":"w","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"multipart/x-mixed-replace":{"schema":{"format":"binary","type":"string"}}},"description":"MJPEG 流"}},"summary":"MJPEG 流（兼容模式）","tags":["播放"]}},"/live/renew":{"post":{"description":"不传 did 则续期全部。冷却期内会返回错误。","parameters":[{"description":"设备 DID（可空）","in":"query","name":"did","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"每个设备的续期结果"}},"summary":"手动续期设备凭据","tags":["播放"]}},"/live/snapshot":{"get":{"parameters":[{"description":"设备 DID","in":"query","name":"did","required":true,"schema":{"type":"string"}},{"description":"宽度，0=原画","in":"query","name":"w","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"image/jpeg":{"schema":{"format":"binary","type":"string"}}},"description":"JPEG 图片"}},"summary":"抓拍单帧","tags":["播放"]}},"/live/source-status":{"get":{"description":"查询各设备的 cs2 凭据缓存时间与刷新冷却。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"凭据状态列表"}},"summary":"凭据状态","tags":["播放"]}},"/platform":{"get":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"运行平台信息"}},"summary":"平台信息","tags":["系统"]}},"/ptz/move":{"post":{"description":"operation: 1=查询 2=左 3=右 4=下 5=上。注意：同一设备同时只能有一路 cs2 连接，云台会短暂占用视频通道。","requestBody":{"content":{"application/json":{"schema":{"properties":{"did":{"type":"string"},"operation":{"maximum":5,"minimum":1,"type":"integer"}},"required":["did","operation"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"{\"ok\":true,\"ret\":0,\"angle\":50,\"elevation\":73}"}},"summary":"云台移动","tags":["云台"]}},"/ptz/status":{"get":{"parameters":[{"description":"设备 DID","in":"query","name":"did","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"{\"ok\":true,\"ret\":0,\"angle\":50,\"elevation\":73}"}},"summary":"云台位置查询","tags":["云台"]}},"/recordings":{"get":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"正在录像的任务"}},"summary":"录像任务列表","tags":["录像"]},"post":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"已启动"}},"summary":"开始录像","tags":["录像"]}},"/recordings/batch-delete":{"post":{"description":"三种模式：按日期、按日期之前、指定文件列表。删除失败会返回 failed 列表（常见：文件属主不是服务用户）。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"deleted + total + freedMB"}},"summary":"批量删除录像","tags":["录像"]}},"/recordings/cache":{"get":{"description":"返回缓存文件数、占用、上限、当前编码器。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"缓存统计"}},"summary":"转码缓存状态","tags":["录像"]}},"/recordings/cache/clear":{"post":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"ok + count + freedMB"}},"summary":"清空转码缓存","tags":["录像"]}},"/recordings/cleanup":{"post":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"{\"deleted\":3,\"freedMB\":120.5}"}},"summary":"清理过期录像","tags":["录像"]}},"/recordings/config":{"get":{"description":"分片时长、保留天数、磁盘阈值、缓存上限。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"当前策略"}},"summary":"读取录像策略","tags":["录像"]},"post":{"description":"所有字段可选。带范围校验（分片 10-3600 秒，保留 1-365 天）。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"ok"}},"summary":"修改录像策略","tags":["录像"]}},"/recordings/dates":{"get":{"description":"按日期聚合，返回每天的录像数量和占用大小。","parameters":[{"description":"设备名（目录名）","in":"query","name":"name","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"日期列表"}},"summary":"录像可用日期","tags":["录像"]}},"/recordings/delete":{"post":{"requestBody":{"content":{"application/json":{"schema":{"properties":{"date":{"type":"string"},"file":{"type":"string"},"name":{"type":"string"}},"required":["name","file"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"ok + freedMB"}},"summary":"删除单个录像文件","tags":["录像"]}},"/recordings/download":{"get":{"parameters":[{"description":"设备名","in":"query","name":"name","required":true,"schema":{"type":"string"}},{"description":"日期","in":"query","name":"date","required":false,"schema":{"type":"string"}},{"description":"文件名","in":"query","name":"file","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"MKV 文件"}},"summary":"下载录像原文件","tags":["录像"]}},"/recordings/export":{"post":{"description":"把指定时间段转码成 MP4（对方可直接播放）。异步执行 —— 返回 id，用 status 轮询进度。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"ok + id"}},"summary":"创建片段导出任务","tags":["录像"]}},"/recordings/export/delete":{"post":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"ok"}},"summary":"删除导出任务","tags":["录像"]}},"/recordings/export/download":{"get":{"parameters":[{"description":"任务 ID","in":"query","name":"id","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"MP4 文件"}},"summary":"下载导出结果","tags":["录像"]}},"/recordings/export/status":{"get":{"description":"status: running / done / failed。","parameters":[{"description":"任务 ID（可空 = 全部）","in":"query","name":"id","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"任务详情"}},"summary":"导出任务状态","tags":["录像"]}},"/recordings/files":{"get":{"parameters":[{"description":"设备名（目录名）","in":"query","name":"name","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"文件列表"}},"summary":"录像文件列表","tags":["录像"]}},"/recordings/list":{"get":{"description":"返回文件列表，含时长、大小、缩略图 URL、播放 URL。","parameters":[{"description":"设备名","in":"query","name":"name","required":true,"schema":{"type":"string"}},{"description":"日期（可空 = 全部）","in":"query","name":"date","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"文件列表"}},"summary":"录像文件列表","tags":["录像"]}},"/recordings/play":{"get":{"description":"把录像转码成 H.264 MP4 流式输出。首次播放会同时后台生成缓存；二次播放直接发缓存文件，支持 Range，可随意拖动。注意：源文件是 MKV+HEVC，浏览器都不支持，必须转码。","parameters":[{"description":"设备名","in":"query","name":"name","required":true,"schema":{"type":"string"}},{"description":"日期","in":"query","name":"date","required":false,"schema":{"type":"string"}},{"description":"文件名（.mkv）","in":"query","name":"file","required":true,"schema":{"type":"string"}},{"description":"起始秒数（拖动用）","in":"query","name":"t","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"video/mp4":{"schema":{"format":"binary","type":"string"}}},"description":"MP4 流（缓存命中时支持 Range）"}},"summary":"录像回放（转码）","tags":["录像"]}},"/recordings/stop":{"post":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"已停止"}},"summary":"停止录像","tags":["录像"]}},"/recordings/thumb":{"get":{"description":"取第 1 秒的帧，320 宽，磁盘缓存。","parameters":[{"description":"设备名","in":"query","name":"name","required":true,"schema":{"type":"string"}},{"description":"日期","in":"query","name":"date","required":false,"schema":{"type":"string"}},{"description":"文件名","in":"query","name":"file","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"image/jpeg":{"schema":{"format":"binary","type":"string"}}},"description":"JPEG 缩略图"}},"summary":"录像缩略图","tags":["录像"]}},"/setup/check":{"get":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"检查项列表"}},"summary":"环境自检","tags":["系统"]}},"/setup/repair":{"post":{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"修复结果"}},"summary":"一键修复","tags":["系统"]}},"/storage":{"get":{"description":"磁盘容量、录像占用、各摄像头明细、预计可录时长。","responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"存储总览"}},"summary":"存储总览","tags":["存储"]}},"/storage/cleanup-preview":{"get":{"parameters":[{"description":"保留天数，默认取配置","in":"query","name":"keepDays","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"可清理文件列表"}},"summary":"清理预览","tags":["存储"]}}},"servers":[{"description":"飞牛网关（插件内）","url":"/app/micam"},{"description":"局域网直连","url":"http://\u003cnas-ip\u003e:8900"}],"tags":[{"name":"系统"},{"name":"账号"},{"name":"设备"},{"name":"播放"},{"name":"云台"},{"name":"录像"},{"name":"存储"},{"name":"诊断"},{"name":"开发者"}]}
