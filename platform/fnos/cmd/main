#!/bin/bash
# MiCam 生命周期脚本
# 由飞牛应用框架调用：main start|stop|status|install|uninstall|upgrade

set -u

APP_NAME="micam"
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
SOCKET_FILE="${TRIM_APPDEST}/app.sock"
APP_BIN="${TRIM_APPDEST}/server/micamd"
CONFIG_FILE="${TRIM_PKGETC}/config.json"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid="$1"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# current_pid 找当前运行的 PID。
current_pid() {
    if [ -r "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d "[:space:]")
        if check_process "$pid"; then
            echo "$pid"
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    pgrep -f "${APP_BIN}" 2>/dev/null | head -1
}

status() {
    local pid
    pid=$(current_pid)
    [ -n "$pid" ] && return 0
    return 1
}

# need_restart 判断是否需要重启（二进制比进程新）。
#
# 为什么需要：飞牛应用中心升级插件时只替换文件，
# 如果进程还在跑就报 "already running" 不重启，
# 结果旧二进制继续运行 —— 表现为「装了新版没生效」。
need_restart() {
    local pid="$1"
    [ -z "$pid" ] && return 1
    [ ! -f "${APP_BIN}" ] && return 1

    local bin_time proc_time
    bin_time=$(stat -c %Y "${APP_BIN}" 2>/dev/null || echo 0)
    proc_time=$(stat -c %Y "/proc/${pid}" 2>/dev/null || echo 0)

    # 二进制比进程新 -> 需要重启
    [ "$bin_time" -gt "$proc_time" ] 2>/dev/null && return 0
    return 1
}

start_process() {
    local pids
    pids=$(pgrep -f "${APP_BIN}" 2>/dev/null || true)

    if [ -n "$pids" ]; then
        local restart_needed=0
        for p in $pids; do
            if need_restart "$p"; then
                restart_needed=1
                break
            fi
        done
        if [ "$restart_needed" -eq 1 ]; then
            log_msg "检测到二进制已更新或存在多重残留进程，清理旧进程 ($pids)"
            kill $pids 2>/dev/null || true
            local n=0
            while pgrep -f "${APP_BIN}" >/dev/null 2>&1 && [ "$n" -lt 15 ]; do
                sleep 1
                n=$((n + 1))
            done
            pgrep -f "${APP_BIN}" 2>/dev/null | xargs -r kill -KILL 2>/dev/null || true
            rm -f "${PID_FILE}"
            sleep 1
        else
            return 0
        fi
    fi

    log_msg "Starting process ..."

    if [ ! -x "${APP_BIN}" ]; then
        log_msg "ERROR: binary not executable: ${APP_BIN}"
        return 1
    fi

    mkdir -p "${TRIM_PKGVAR}"
    rm -f "${SOCKET_FILE}"

    # 同时监听：Unix socket（飞牛网关）+ TCP（局域网客户端）
    #
    # 关键：用 --daemon 让程序自己 daemon 化。
    # shell 的 nohup/setsid 在 systemd/sudo 环境下不可靠
    # （父会话退出时子进程仍会被 SIGHUP 杀掉，表现为「启动后 1 秒退出」）。
    "${APP_BIN}" \
        --daemon \
        --socket "${SOCKET_FILE}" \
        --http ":8900" \
        --config "${CONFIG_FILE}" \
        --data "${TRIM_PKGVAR}" \
        --ffmpeg "/usr/bin/ffmpeg" \
        >> "${LOG_FILE}" 2>&1 < /dev/null

    # daemon 化后，用 pgrep 找真实 PID
    sleep 2
    local realpid
    realpid=$(pgrep -f "${APP_BIN}" | head -1)
    if [ -n "$realpid" ]; then
        printf "%s" "$realpid" > "${PID_FILE}"
        log_msg "started pid=$realpid"
        return 0
    fi

    log_msg "ERROR: process exited immediately"
    return 1
}

stop_process() {
    log_msg "Stopping process ..."

    local pids
    pids=$(pgrep -f "${APP_BIN}" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        kill $pids 2>/dev/null || true
        local n=0
        while pgrep -f "${APP_BIN}" >/dev/null 2>&1 && [ "$n" -lt 20 ]; do
            sleep 1
            n=$((n + 1))
        done
        pgrep -f "${APP_BIN}" 2>/dev/null | xargs -r kill -KILL 2>/dev/null || true
    fi

    rm -f "${PID_FILE}" "${SOCKET_FILE}"
    return 0
}

case "${1:-}" in
    start)
        start_process
        ;;
    stop)
        stop_process
        ;;
    restart)
        stop_process
        sleep 1
        start_process
        ;;
    status)
        if status; then exit 0; else exit 3; fi
        ;;
    *)
        exit 1
        ;;
esac